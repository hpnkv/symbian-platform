{
  "version": 6,
  "configurePresets": [
    {
      "name": "symbian-pic",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../.symbian/cmake/gui-app",
      "toolchainFile": "${sourceDir}/../../symbian/toolchain/cmake/symbian-arm.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SYMBIAN_TARGET_ARCH": "armv6",
        "SYMBIAN_GUI_SDK_INCLUDE": "${sourceDir}/../../.symbian/gui-sdk/include"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "symbian-pic",
      "configurePreset": "symbian-pic"
    }
  ]
}
