# Native reference, built after MkDocs from doc/cpp/ into doc/site/cpp/.
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Symbian platform (C++)"
PROJECT_BRIEF          = "Native application APIs, runtime and tooling"
INPUT                  = ../../cpp/symbian mainpage.md
USE_MDFILE_AS_MAINPAGE = mainpage.md
RECURSIVE              = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ../..
STRIP_FROM_INC_PATH    = ../..
FILE_PATTERNS          = *.h *.cc *.md
EXCLUDE_PATTERNS       = */upstream/* */tests/* */runtime/include/* */internal/*
EXCLUDE_SYMBOLS        = *::internal::* pybind11::* absl::*
OUTPUT_DIRECTORY       = ../site
HTML_OUTPUT            = cpp
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 4
AUTOLINK_SUPPORT       = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
QUIET                  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_DYNAMIC_MENUS     = YES
HTML_COPY_CLIPBOARD    = YES
HTML_CODE_FOLDING      = YES
SEARCHENGINE           = YES
HTML_FOOTER            = footer.html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_COLORSTYLE_HUE    = 232
HTML_COLORSTYLE_SAT    = 60
HTML_COLORSTYLE_GAMMA  = 90
HTML_EXTRA_STYLESHEET  = theme/doxygen-awesome.css typography.css
HTML_EXTRA_FILES       = cpp-declarations.js
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
