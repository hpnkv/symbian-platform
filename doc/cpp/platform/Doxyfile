# Curated original Symbian declarations, separate from the SDK-owned API index.
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Original Symbian headers"
PROJECT_BRIEF          = "Selected EUSER, Window Server, networking, graphics and device declarations"
INPUT                  = headers mainpage.md
USE_MDFILE_AS_MAINPAGE = mainpage.md
RECURSIVE              = NO
FULL_PATH_NAMES        = NO
FILE_PATTERNS          = *.h *.md
OUTPUT_DIRECTORY       = ../../site/cpp
HTML_OUTPUT            = platform
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF          = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
ALIASES                = "publishedAll=Published to all clients." \
                         "publishedPartner=Published to platform partners." \
                         "released=Released API." \
                         "removed=Removed API." \
                         "internalAll=Internal API." \
                         "internalComponent=Internal component API." \
                         "internalConponent=Internal component API." \
                         "internalTechnology=Internal technology API." \
                         "capability=Required capability:" \
                         "leave=Leave condition:" \
                         "panic=Panic condition:" \
                         "prototype=Prototype:"
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO
QUIET                  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
HTML_DYNAMIC_MENUS     = YES
HTML_COPY_CLIPBOARD    = YES
SEARCHENGINE           = YES
HTML_FOOTER            = ../footer.html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_COLORSTYLE_HUE    = 232
HTML_COLORSTYLE_SAT    = 60
HTML_COLORSTYLE_GAMMA  = 90
HTML_EXTRA_STYLESHEET  = ../theme/doxygen-awesome.css ../typography.css
HAVE_DOT               = NO
SOURCE_BROWSER         = YES
