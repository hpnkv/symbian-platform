    "stdapis/net/if.h": {"preinclude": ["sys/types.h", "sys/socket.h"]},
    "stdapis/net/if_var.h": {"preinclude": ["sys/types.h", "sys/socket.h"]},
    "stdapis/net/radix.h": {"preinclude": ["sys/types.h"]},
    "stdapis/net/route.h": {"preinclude": ["sys/types.h", "sys/socket.h"]},
