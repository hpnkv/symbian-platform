       pagesize(GetPageSize()),
       round_up(RoundedUpBlockSize()),
@@ -436,6 +452,10 @@ bool LowLevelAlloc::DeleteArena(Arena *arena) {
                    "empty arena has non-page-aligned block size");
     ABSL_RAW_CHECK(reinterpret_cast<uintptr_t>(region) % arena->pagesize == 0,
                    "empty arena has non-page-aligned block");
+#ifdef __SYMBIAN32__
+    // The owner list below closes each chunk once. Adjacent chunks can
+    // coalesce into one freelist entry, so region boundaries are insufficient.
+#else
     int munmap_result;
 #ifdef _WIN32
     munmap_result = VirtualFree(region, 0, MEM_RELEASE);
@@ -456,7 +476,15 @@ bool LowLevelAlloc::DeleteArena(Arena *arena) {
                    errno);
     }
 #endif  // _WIN32
+#endif  // __SYMBIAN32__
   }
+#ifdef __SYMBIAN32__
+  while (arena->page_owners != nullptr) {
+    SymbianRuntimePageOwner* owner = arena->page_owners;
+    arena->page_owners = SymbianRuntimePageNext(owner);
+    SymbianRuntimePageClose(owner);
+  }
+#endif
   section.Leave();
   arena->~Arena();
   Free(arena);
@@ -584,7 +612,17 @@ static void *DoAllocWithArena(size_t request, LowLevelAlloc::Arena *arena) {
       // the chances/impact of fragmentation:
       size_t new_pages_size = RoundUp(req_rnd, arena->pagesize * 16);
       void *new_pages;
-#ifdef _WIN32
+#ifdef __SYMBIAN32__
+      SymbianRuntimePageOwner* owner = nullptr;
+      new_pages = nullptr;
+      ABSL_RAW_CHECK(new_pages_size <= 0x7fffffffU,
+                     "Symbian page request too large");
+      const int map_result = SymbianRuntimePageCreate(
+          static_cast<unsigned int>(new_pages_size), &owner, &new_pages);
+      ABSL_RAW_CHECK(map_result == 0 && owner != nullptr &&
+                         new_pages != nullptr,
+                     "Symbian page allocation failed");
+#elif defined(_WIN32)
       new_pages = VirtualAlloc(nullptr, new_pages_size,
                                MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
       ABSL_RAW_CHECK(new_pages != nullptr, "VirtualAlloc failed");
@@ -619,6 +657,10 @@ static void *DoAllocWithArena(size_t request, LowLevelAlloc::Arena *arena) {
 #endif  // __linux__
 #endif  // _WIN32
       arena->mu.lock();
+#ifdef __SYMBIAN32__
+      SymbianRuntimePageSetNext(owner, arena->page_owners);
+      arena->page_owners = owner;
+#endif
       s = reinterpret_cast<AllocList *>(new_pages);
       s->header.size = new_pages_size;
