+void display_widget::wheelEvent(QWheelEvent *event) {
+    // Symbian applications consume touch drags, not host wheel notches. Keep
+    // high-resolution pixel deltas (including host momentum) without rounding
+    // each individual event. Qt has already applied the user's scroll direction.
+    if (width() < 8 || height() < 8 || !raw_mouse_event || mouse_drag_active_
+        || std::any_of(active_pointers_.begin(), active_pointers_.end(), [](int id) { return id != 0; })) {
+        event->ignore();
+        return;
+    }
+    QPointF delta = event->pixelDelta();
+    if (delta.isNull()) {
+        delta = QPointF(event->angleDelta()) * (40.0 / 120.0);
+    }
+    if (!delta.isNull()) {
+        const QPointF anchor(width() * 0.5, height() * 0.5);
+        const qreal scale = devicePixelRatioF();
+        const auto deliver = [&](int action) {
+            raw_mouse_event(userdata_, eka2l1::vec3(std::lround(wheel_position_.x() * scale),
+                std::lround(wheel_position_.y() * scale), 0), 0, action, 0);
+        };
+        if (!wheel_active_) {
+            wheel_position_ = anchor;
+            wheel_active_ = true;
+            deliver(0);
+        }
+        // Long gestures need another drag before reaching the device edge.
+        // Release/re-anchor without emitting a backwards motion or dropping delta.
+        while (!delta.isNull()) {
+            qreal fraction = 1.0;
+            const auto limit = [&](qreal position, qreal distance, qreal extent) {
+                if (distance > 0) return (extent - 2.0 - position) / distance;
+                if (distance < 0) return (1.0 - position) / distance;
+                return 1.0;
+            };
+            fraction = std::clamp(std::min({fraction,
+                limit(wheel_position_.x(), delta.x(), width()),
+                limit(wheel_position_.y(), delta.y(), height())}), 0.0, 1.0);
+            wheel_position_ += delta * fraction;
+            deliver(1);
+            delta *= 1.0 - fraction;
+            if (fraction < 1.0) {
+                deliver(2);
+                wheel_position_ = anchor;
+                deliver(0);
+            }
+        }
+    }
+    if (event->phase() == Qt::ScrollEnd) {
+        finish_wheel_gesture();
+    } else if (wheel_active_) {
+        // Wheels without phases need an idle release. This is a single-shot
+        // deadline, not a polling timer; phased trackpads retain their gesture.
+        if (event->phase() == Qt::NoScrollPhase) wheel_release_timer_.start(120);
+        else wheel_release_timer_.stop();
+    }
+    event->accept();
+}
