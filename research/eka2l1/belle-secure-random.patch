+    // Belle's EUSER Math::RandomL wrapper calls this executive service.
+    // Unlike Math::Random, it must report an unavailable random source.
+    BRIDGE_FUNC(std::int32_t, math_secure_random, epoc::desc8 *output) {
+        if (!output || !output->is_valid_descriptor()) {
+            return epoc::error_argument;
+        }
+        const auto kind = output->get_descriptor_type();
+        if (kind != epoc::des_type::ptr && kind != epoc::des_type::buf &&
+            kind != epoc::des_type::ptr_to_buf) {
+            return epoc::error_argument;
+        }
+        const std::uint32_t length = output->get_length();
+        if (length > 1024 || length > output->get_max_length(kern->crr_process())) {
+            return epoc::error_argument;
+        }
+        if (length == 0) {
+            return epoc::error_none;
+        }
+        char *bytes = output->get_pointer(kern->crr_process());
+        if (!bytes) {
+            return epoc::error_argument;
+        }
+        // libuv's synchronous path uses the host OS cryptographic source and
+        // returns an error if that source is unavailable.
+        if (uv_random(nullptr, nullptr, bytes, length, 0, nullptr) != 0) {
+            std::memset(bytes, 0, length);
+            return epoc::error_not_ready;
+        }
+        return epoc::error_none;
+    }
