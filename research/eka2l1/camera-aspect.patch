+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#pragma once
+
+#include <QImage>
+#include <QTransform>
+
+namespace eka2l1::drivers::camera {
+    // Preserve one complete source axis. The guest may request a portrait buffer
+    // from a landscape host camera; stretching here cannot be undone by its UI.
+    inline QImage prepare_camera_image(QImage image, const int width, const int height,
+        const int rotation_ccw_deg) {
+        if (image.isNull() || width <= 0 || height <= 0) {
+            return {};
+        }
+        const int rotation = ((rotation_ccw_deg % 360) + 360) % 360;
+        if (rotation != 0) {
+            image = image.transformed(QTransform().rotate(-rotation), Qt::FastTransformation);
+        }
+        image = image.scaled(width, height, Qt::KeepAspectRatioByExpanding,
+            Qt::SmoothTransformation);
+        if (image.isNull()) {
+            return {};
+        }
+        return image.copy((image.width() - width) / 2, (image.height() - height) / 2,
+            width, height);
+    }
+}
