+    // the window on the first Qt show while retaining later pointer focus.
+    if (qEnvironmentVariable("EKA2L1_RESEARCH_BACKGROUND_WINDOW") == "1") {
+        // A background macOS process has no usable application menu bar.
+        // Keep every emulator menu in the window for tests and IDE sessions.
+        ui_->menu_bar->setNativeMenuBar(false);
