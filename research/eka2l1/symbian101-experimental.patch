diff --git a/src/emu/kernel/src/svc.cpp b/src/emu/kernel/src/svc.cpp
index 803c79a..a91c299 100644
--- a/src/emu/kernel/src/svc.cpp
+++ b/src/emu/kernel/src/svc.cpp
@@ -6105,6 +6105,26 @@ namespace eka2l1::epoc {
         BRIDGE_REGISTER(0x10D, library_load_prepare)
     };
 
+    const eka2l1::hle::func_map svc_register_funcs_v101 = [] {
+        eka2l1::hle::func_map result;
+        for (const auto &[old_number, handler] : svc_register_funcs_v10) {
+            // Public source/ROM wrapper comparison establishes two insertions
+            // after ExecuteInSupervisorMode and one missing slot between
+            // ThreadStackInfo and CondVarCreate. The two intervening private
+            // operations have no independent semantic mapping yet.
+            // The two newer loader extensions lack that independent mapping.
+            if (old_number == 0xD6 || old_number == 0xD7
+                || old_number == 0x10C || old_number == 0x10D) {
+                continue;
+            }
+            const auto number = old_number <= 0x10 || old_number >= 0x800000
+                ? old_number
+                : old_number < 0xD7 ? old_number + 2 : old_number + 1;
+            result.emplace(number, handler);
+        }
+        return result;
+    }();
+
