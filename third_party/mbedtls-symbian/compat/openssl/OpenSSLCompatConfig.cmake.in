@PACKAGE_INIT@
if(NOT @SYMBIAN_MBEDTLS_HOST@)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Generic" OR
     NOT SYMBIAN_TARGET_ARCH STREQUAL "@SYMBIAN_TARGET_ARCH@")
    message(FATAL_ERROR "This OpenSSL compatibility package requires @SYMBIAN_TARGET_ARCH@ Symbian")
  endif()
  include(CMakeFindDependencyMacro)
  find_dependency(MbedTLS CONFIG)
  if(NOT TARGET Symbian::Runtime)
    include(SymbianApp)
  endif()
else()
  include(CMakeFindDependencyMacro)
  find_dependency(absl CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLCompatTargets.cmake")
check_required_components(OpenSSLCompat)
